<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_liv_delivery_tree" model="ir.ui.view">
        <field name="name">liv.delivery.tree</field>
        <field name="model">liv.delivery</field>
        <field name="arch" type="xml">
            <tree string="Deliveries" decoration-muted="state == 'cancelled'" decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="driver_id"/>
                <field name="state" widget="badge" decoration-info="state in ('assigned', 'en_route', 'arrived')"/>
                <field name="last_ts"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_liv_delivery_form" model="ir.ui.view">
        <field name="name">liv.delivery.form</field>
        <field name="model">liv.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery Mission">
                <header>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary"
                        invisible="state != 'draft' or not driver_id"/>
                    <button name="action_start" string="Start" type="object" class="btn-primary"
                        invisible="state != 'assigned'"/>
                    <button name="action_arrive" string="Arrive" type="object" class="btn-primary"
                        invisible="state != 'en_route'"/>
                    <button name="action_deliver" string="Deliver" type="object" class="btn-success"
                        invisible="state not in ('en_route', 'arrived')"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger"
                        invisible="state in ('delivered', 'cancelled')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <group>
                        <group string="Mission">
                            <field name="name"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,assigned,en_route,arrived,delivered"/>
                            <field name="driver_id"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <group string="Destination (optional)">
                        <group>
                            <field name="lat"/>
                            <field name="lon"/>
                        </group>
                    </group>
                    <group string="Last known position (from tracking)" invisible="not last_ts">
                        <group>
                            <field name="last_lat"/>
                            <field name="last_lon"/>
                            <field name="last_ts"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tracking Snapshots" name="tracks">
                            <field name="track_ids" readonly="1" nolabel="1">
                                <tree create="0" delete="1" edit="0">
                                    <field name="driver_id"/>
                                    <field name="lat"/>
                                    <field name="lon"/>
                                    <field name="ts"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_liv_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">liv.delivery</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first delivery mission.
            </p>
            <p>
                Set customer, address, assign a driver, then use the buttons to move through states:
                Assign → Start → Arrive → Deliver. Tracking snapshots are added automatically when the driver sends position via the app.
            </p>
        </field>
    </record>

    <!-- Menu LIV / Deliveries -->
    <menuitem id="menu_liv_delivery"
        name="Deliveries"
        parent="menu_liv_root"
        action="action_liv_delivery"
        sequence="5"/>
</odoo>
