<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view: shows status/updated/message/base_url only — secret is never displayed -->
    <record id="view_liv_backend_health_display_form" model="ir.ui.view">
        <field name="name">liv.backend.health.display.form</field>
        <field name="model">liv.backend.health.display</field>
        <field name="arch" type="xml">
            <form string="LIV Backend Status" create="false" edit="false" delete="false">
                <sheet>
                    <group string="Status">
                        <field name="status" readonly="1"/>
                        <field name="updated" readonly="1"/>
                        <field name="base_url" readonly="1"/>
                    </group>
                    <group string="Message">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>
                    <div class="text-muted">
                        Les valeurs sont lues depuis les paramètres système au moment de l'ouverture.
                        Le secret n'est jamais affiché ici.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action: opens the transient form for a given res_id -->
    <record id="action_liv_backend_health_display" model="ir.actions.act_window">
        <field name="name">LIV Backend Status</field>
        <field name="res_model">liv.backend.health.display</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_liv_backend_health_display_form"/>
        <field name="target">new</field>
    </record>

    <!-- Server action: create transient record, return window action to open it -->
    <record id="action_server_liv_backend_health" model="ir.actions.server">
        <field name="name">LIV Backend Status</field>
        <field name="model_id" ref="liv_delivery.model_liv_backend_health_display"/>
        <field name="state">code</field>
        <field name="code">
record = env['liv.backend.health.display'].get_display_record()
action = {
    'type': 'ir.actions.act_window',
    'name': 'LIV Backend Status',
    'res_model': 'liv.backend.health.display',
    'res_id': record.id,
    'view_mode': 'form',
    'view_id': env.ref('liv_delivery.view_liv_backend_health_display_form').id,
    'target': 'new',
}
        </field>
    </record>

    <menuitem id="menu_liv_backend_health"
        name="Backend Status"
        parent="menu_liv_root"
        action="action_server_liv_backend_health"
        sequence="90"/>
</odoo>
