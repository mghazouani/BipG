<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_liv_delivery_track_tree" model="ir.ui.view">
        <field name="name">liv.delivery.track.tree</field>
        <field name="model">liv.delivery.track</field>
        <field name="arch" type="xml">
            <tree string="Delivery Tracking Snapshots" create="false" delete="true" edit="true">
                <field name="id" column_invisible="1"/>
                <field name="delivery_id"/>
                <field name="driver_id"/>
                <field name="lat"/>
                <field name="lon"/>
                <field name="ts"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_liv_delivery_track_form" model="ir.ui.view">
        <field name="name">liv.delivery.track.form</field>
        <field name="model">liv.delivery.track</field>
        <field name="arch" type="xml">
            <form string="Delivery Tracking Snapshot">
                <sheet>
                    <group>
                        <group>
                            <field name="delivery_id"/>
                            <field name="driver_id"/>
                            <field name="ts"/>
                        </group>
                        <group>
                            <field name="lat"/>
                            <field name="lon"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_liv_delivery_track" model="ir.actions.act_window">
        <field name="name">Tracking Snapshots</field>
        <field name="res_model">liv.delivery.track</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun snapshot pour le moment.
            </p>
            <p>
                Les snapshots sont créés automatiquement par le service FastAPI
                (une fois par minute par commande) lorsque des positions sont envoyées
                via le WebSocket <code>/ws/track</code> (payload avec <code>delivery_id</code>).
            </p>
        </field>
    </record>

    <!-- Root menu LIV -->
    <menuitem id="menu_liv_root"
        name="LIV"
        sequence="50"/>

    <!-- Submenu Tracking Snapshots -->
    <menuitem id="menu_liv_delivery_track"
        name="Tracking Snapshots"
        parent="menu_liv_root"
        action="action_liv_delivery_track"
        sequence="10"/>
</odoo>
